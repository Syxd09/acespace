# Ace Spaces Studio AI Assistant — Optional External LLM Integration
#
# NOTE: The Ace Spaces AI Material Bot works 100% out of the box with zero configuration!
# It runs a private, in-house, grounded architectural intelligence engine offline.
#
# Whenever you are ready to provide an external LLM API key, simply create a `.env.local`
# or `.env` file in the project root and add your key below:

# Option 1: OpenAI or OpenAI-Compatible API Key (e.g. GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Option 2: Generic AI Key (auto-detected by /api/ai/chat)
# AI_API_KEY=your_api_key_here

# Option 3: Google Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Configuration (can also be updated dynamically via /admin)
NEXT_PUBLIC_WHATSAPP_NUMBER=+919845012345
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 98450 12345

# Dispatch & Order Notifications (Optional)
# RESEND_API_KEY=re_123456789
# ADMIN_NOTIFICATION_EMAIL=studio@acespaces.in
# NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/...

